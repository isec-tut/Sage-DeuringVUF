#!/usr/bin/env bash
set -euo pipefail

# Match the image used to verify the full suite in README.md.
image='sagemath/sagemath@sha256:19995db6194f4a4bab18ce9a88556fd15b9ed5e916b4504fefe618a7796ddbdb'
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
docker_args=()
if [[ -n "${SAGE_DOCKER_CONTEXT:-}" ]]; then
    docker_args+=(--context "$SAGE_DOCKER_CONTEXT")
elif docker context inspect desktop-linux >/dev/null 2>&1; then
    docker_args+=(--context desktop-linux)
fi
terminal_args=(-i)
if [[ -t 0 && -t 1 ]]; then
    terminal_args+=(-t)
fi
exec docker "${docker_args[@]}" run --rm "${terminal_args[@]}" \
    --mount "type=bind,source=$root,target=/work,readonly" \
    -w /work -e PYTHONDONTWRITEBYTECODE=1 "$image" sage "$@"
